# Voorbeeldwaarden. Echte waarden staan alleen in de Kubernetes-Secret.

# Mail
MAIL_TO=vgm@example.com
MAIL_FROM="Werkplekinspectie <inspectie@example.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=example-user
SMTP_PASS=change-me

# Organisatie (PDF-kop)
ORG_NAME="Voorbeeld B.V."
# Meerdere regels, gescheiden door \n
ORG_ADDRESS="Voorbeeldstraat 1\n1234 AB Voorbeeldstad"
ORG_DEPARTMENT="Customer Care"
VGM_NAME="J. Jansen"
# Optioneel: pad naar een gemount logo (SVG of PNG)
BRAND_LOGO_FILE=/config/logo.svg

# Server
PORT=8080
PUBLIC_ORIGIN=https://inspectie.example.com
# IP/CIDR van de vertrouwde proxy (cloudflared)
TRUST_PROXY=10.0.0.0/8
NODE_ENV=production

# Misbruikgrenzen
RATE_LIMIT_PER_IP=5
RATE_LIMIT_WINDOW="15 minutes"
RATE_LIMIT_GLOBAL_PER_HOUR=20
