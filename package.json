{
  "name": "werkplekinspectie",
  "version": "0.1.0",
  "private": true,
  "description": "Werkplekinspectie Arbo en Milieu als PWA",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "@fontsource-variable/nunito": "^5.3.0",
    "@lukeed/ms": "^2.0.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "fastify": "^5.12.8",
    "idb-keyval": "^6.3.0",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.21.0",
    "proxy-addr": "^2.0.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "signature_pad": "^5.1.5",
    "svg-to-pdfkit": "^0.1.8",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/proxy-addr": "^2.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/svg-to-pdfkit": "^0.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "unpdf": "^2.2.1",
    "vite": "^8.3.8",
